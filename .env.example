# Chép thành .env rồi sửa, hoặc đặt trực tiếp làm biến môi trường khi chạy.
# Giá trị KHÔNG cần bọc nháy, kể cả khi có khoảng trắng hay dấu tiếng Việt.
# Biến đã đặt sẵn từ shell hoặc systemd luôn thắng file này.

# Tên đơn vị hiện trên đầu trang.
ORG_NAME=Phòng 1

# Cổng và địa chỉ lắng nghe.
# HOST=0.0.0.0 để các máy khác trong mạng nội bộ vào được.
# HOST=127.0.0.1 nếu chỉ chạy trên chính máy này.
PORT=3000
HOST=0.0.0.0

# Nơi chứa cơ sở dữ liệu và file đính kèm. Mặc định là ./data
# DATA_DIR=/var/lib/quan-ly-so-van-ban

# Đặt =1 khi có nginx/IIS làm proxy phía trước, để đọc đúng IP và HTTPS.
# TRUST_PROXY=1
